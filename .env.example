LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:4b fits an 8 GB Mac; use qwen3 (8B), llama3.1, gemma3, etc. on larger machines.
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_MB=10
# Optional evaluator weight overrides (JSON, normalized to 100):
# RECRUITER_WEIGHTS={"required_experience": 25, "required_skills": 20}
# HIRING_MANAGER_WEIGHTS={"direct_relevant_experience": 25}
